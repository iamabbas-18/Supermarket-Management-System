{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Supermarket",
            "type": "shell",
            "command": "gcc",
            "args": [
                "main.c",
                "inventory.c",
                "billing.c",
                "reports.c",
                "-o",
                "supermarket.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build and Run Supermarket",
            "dependsOn": "Compile Supermarket",
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "${workspaceFolder}\\supermarket.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}