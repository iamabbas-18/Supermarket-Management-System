{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Supermarket",
            "type": "shell",
            "command": "gcc",
            "args": [
                "main.c",
                "inventory.c",
                "billing.c",
                "reports.c",
                "-o",
                "supermarket.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}